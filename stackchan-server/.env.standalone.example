# Copy this file to .env and fill in the values for your installation.
STACKCHAN_LOCAL_HOST=192.168.1.100
STACKCHAN_AI_PROVIDER=openai
STACKCHAN_OPENAI_API_KEY=
STACKCHAN_OPENAI_REALTIME_MODEL=gpt-realtime
STACKCHAN_OPENAI_TTS_VOICE=alloy

# Optional: leave empty to generate and persist a token in ./data/settings-token.
STACKCHAN_SETTINGS_TOKEN=

# Optional OpenAI-compatible pipeline values.
