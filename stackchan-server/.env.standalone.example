# Copy this file to .env and fill in the values for your installation.
STACKCHAN_LOCAL_HOST=192.168.1.100
# Optional: change this if another service (for example the HA add-on) uses host port 12800.
STACKCHAN_WS_PORT=12800
# Optional: change this if the local settings UI port is already in use.
# STACKCHAN_SETTINGS_PORT=8100
STACKCHAN_AI_PROVIDER=openai
STACKCHAN_OPENAI_API_KEY=
STACKCHAN_OPENAI_REALTIME_MODEL=gpt-realtime
STACKCHAN_OPENAI_TTS_VOICE=alloy
STACKCHAN_GEMINI_API_KEY=
STACKCHAN_GEMINI_MODEL=gemini-2.5-flash-native-audio-latest
STACKCHAN_GEMINI_VOICE=Aoede
# Optional direct Home Assistant bridge for entity control; leave disabled for no-HA use.
# The URL may be http(s)://host:8123 or the full /api/websocket URL.
STACKCHAN_STANDALONE_HA_ENABLED=false
STACKCHAN_STANDALONE_HA_URL=
STACKCHAN_STANDALONE_HA_TOKEN=
# Gemini HA tools start disabled; enable them in the GUI after the bridge is configured.
STACKCHAN_GEMINI_ENABLE_TOOLS=false
STACKCHAN_GEMINI_ENABLE_SEARCH=false

# TokenHub and OpenRouter are LLM entries for the compatible STT/TTS pipeline.
# Set STACKCHAN_AI_PROVIDER to tokenhub or openrouter when using one of them.
# STACKCHAN_TOKENHUB_BASE_URL=https://example.invalid/v1
# STACKCHAN_TOKENHUB_API_KEY=
# STACKCHAN_OPENROUTER_API_KEY=

# Optional: leave empty to generate and persist a token in ./data/settings-token.
STACKCHAN_SETTINGS_TOKEN=

# Optional OpenAI-compatible pipeline values.
# STACKCHAN_COMPATIBLE_BASE_URL=https://example.invalid/v1
# STACKCHAN_COMPATIBLE_API_KEY=
# STACKCHAN_COMPATIBLE_MODEL=
# STACKCHAN_COMPATIBLE_STT_MODEL=whisper-1
# STACKCHAN_COMPATIBLE_TTS_MODEL=tts-1
# STACKCHAN_COMPATIBLE_TTS_VOICE=alloy
# STACKCHAN_STT_BASE_URL=
# STACKCHAN_STT_API_KEY=
# STACKCHAN_STT_MODEL=
# STACKCHAN_LLM_BASE_URL=
# STACKCHAN_LLM_API_KEY=
# STACKCHAN_LLM_MODEL=
# STACKCHAN_TTS_BASE_URL=
# STACKCHAN_TTS_API_KEY=
# STACKCHAN_TTS_MODEL=
# STACKCHAN_TTS_VOICE=

# Optional first-start defaults; these values can also be edited in the GUI.
# STACKCHAN_DEVICE_PROFILES={}
# STACKCHAN_SYSTEM_PROMPT=You are StackChan, a friendly desktop robot assistant. Keep replies concise.
# STACKCHAN_AUDIO_PREBUFFER_MS=300
# STACKCHAN_AUDIO_PREBUFFER_MAX_WAIT_MS=900
